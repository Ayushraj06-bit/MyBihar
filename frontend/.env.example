# MyBihar — copy to .env.local and fill in. Nothing here is required to run the
# tests; the app degrades to the seeded catalogue and fallback cards without it.

# --- Signing in ---------------------------------------------------------------
# Accounts live in a Supabase project (Authentication → Providers → Google).
# Without one, the login screen says so instead of sending you to a dead host.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Looking around without a project: one fixed local account, `next dev` only —
# production builds ignore it. Remove once the two values above are filled in.
# NEXT_PUBLIC_AUTH_DEV_BYPASS=true

# --- Postgres (Prisma) --------------------------------------------------------
# Leave DATABASE_URL unset and every catalogue route serves prisma/seed-data.mjs.
# Prisma: the pooled URL for runtime queries, the direct one for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Explore (places) -------------------------------------------------------
# "false" keeps Explore on the file catalogue in frontend/data (no database)
EXPLORE_DATABASE_ENABLED="false"
# EXPLORE_CATALOG_DIR=./data/places

# Ola Maps: the public key only renders the map tiles in the browser; the
# private key is used server-side for Places search and never leaves the server.
NEXT_PUBLIC_OLA_MAPS_API_KEY=
OLA_MAPS_API_KEY=
# OLA_MAPS_REQUEST_ORIGIN=https://mybihar.example

# --- Editorial news (Home "In the news") -------------------------------------
# Anakin search + scrape, used by the daily cron at /api/cron/news
ANAKIN_API_KEY=
CRON_SECRET=

# --- Optional -----------------------------------------------------------------
# NEXT_PUBLIC_GA_ID=
# DEV_ALLOWED_ORIGINS=http://localhost:3000
